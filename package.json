{
  "name": "exp4j-candy",
  "version": "1.0.0",
  "description": "JSweet candy for exp4j expression evaluator - TypeScript port with optimizations",
  "keywords": ["jsweet", "candy", "exp4j", "expression", "evaluator", "math"],
  "main": "bundle/exp4j.bundle.js",
